Environment=EVOLUTION_CROSS_DERIV_QUARANTINE_RELEASE_STREAK=3
Environment=EVOLUTION_EPISODE_OVERLAP_GUARD=1
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/leantrader/app/runtime/evolution /opt/leantrader/evolution-sidecars

[Install]
WantedBy=multi-user.target
