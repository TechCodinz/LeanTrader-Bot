Environment=EVOLUTION_EXTERNAL_FLOW_DIAGNOSTIC_MIN_Z=2.5
Environment=EVOLUTION_EXTERNAL_FLOW_HISTORY_PER_SYMBOL=24
Environment=EVOLUTION_EXTERNAL_FLOW_PERSISTENCE_MIN_SAMPLES=3
