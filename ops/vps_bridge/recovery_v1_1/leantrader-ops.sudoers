Defaults:leanops env_reset,secure_path=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin,!setenv
Defaults:leantunnel env_reset,secure_path=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin,!setenv
leantunnel ALL=(leanops) NOPASSWD: /usr/local/bin/leantrader-mcp-server
leanops ALL=(root) NOPASSWD: /usr/local/sbin/leantrader-ops-helper host-health
leanops ALL=(root) NOPASSWD: /usr/local/sbin/leantrader-ops-helper status
leanops ALL=(root) NOPASSWD: /usr/local/sbin/leantrader-ops-helper heartbeat summary
leanops ALL=(root) NOPASSWD: /usr/local/sbin/leantrader-ops-helper heartbeat engines
leanops ALL=(root) NOPASSWD: /usr/local/sbin/leantrader-ops-helper heartbeat runtime
leanops ALL=(root) NOPASSWD: /usr/local/sbin/leantrader-ops-helper heartbeat testnet
leanops ALL=(root) NOPASSWD: /usr/local/sbin/leantrader-ops-helper logs 20
leanops ALL=(root) NOPASSWD: /usr/local/sbin/leantrader-ops-helper logs 50
leanops ALL=(root) NOPASSWD: /usr/local/sbin/leantrader-ops-helper logs 100
leanops ALL=(root) NOPASSWD: /usr/local/sbin/leantrader-ops-helper logs 200
leanops ALL=(root) NOPASSWD: /usr/local/sbin/leantrader-ops-helper restart
leanops ALL=(root) NOPASSWD: /usr/local/sbin/leantrader-ops-helper halt
leanops ALL=(root) NOPASSWD: /usr/local/sbin/leantrader-ops-helper deploy
leanops ALL=(root) NOPASSWD: /usr/local/sbin/leantrader-ops-helper repo-read
leanops ALL=(root) NOPASSWD: /usr/local/sbin/leantrader-ops-helper repo-write
