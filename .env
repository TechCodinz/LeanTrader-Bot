# Telegram
TELEGRAM_BOT_TOKEN=REDACTED_ROTATED_TELEGRAM_BOT_TOKEN__SET_VIA_MOUNTED_SECRET_FILE
VIP_CHANNEL_ID=-1002983007302
FREE_CHANNEL_ID=-1002930953007

# EXECUTION POSTURE
#
# This tracked file is a template. It shipped with TRADING_MODE=live,
# BYBIT_TESTNET=false, ENABLE_LIVE=true and ALLOW_LIVE=true -- a live-trading
# configuration one variable (LIVE_CONFIRM=YES) away from real-money
# authority, committed to the repository. It now carries the posture the
# runtime is meant to hold.
#
# Real-money authority requires ENABLE_LIVE, ALLOW_LIVE and LIVE_CONFIRM=YES
# together, deliberately set by an operator on the host. Do not enable them
# here.
EXECUTION_MODE=testnet
TRADING_MODE=testnet
BYBIT_TESTNET=true
ENABLE_LIVE=false
LIVE_CONFIRM=NO

# Bybit TESTNET. Prefer the mounted-file form: the value stays out of the
# process environment and out of docker inspect. See SECRETS.md.
# BYBIT_TESTNET_API_KEY_FILE=/run/secrets/bybit_testnet_api_key
# BYBIT_TESTNET_API_SECRET_FILE=/run/secrets/bybit_testnet_api_secret
BYBIT_TESTNET_API_KEY=YOUR_TESTNET_KEY_HERE
BYBIT_TESTNET_API_SECRET=YOUR_TESTNET_SECRET_HERE

# Bybit LIVE (Real Money - ONLY used when TRADING_MODE=live)
BYBIT_API_KEY=REDACTED_ROTATED_BYBIT_CREDENTIAL__SET_VIA_MOUNTED_SECRET_FILE
BYBIT_API_SECRET=REDACTED_ROTATED_BYBIT_CREDENTIAL__SET_VIA_MOUNTED_SECRET_FILE

# Trading Limits (SAFE DEFAULTS)
MAX_POSITION_SIZE=10
MAX_DAILY_TRADES=999999
MAX_OPEN_POSITIONS=999999
MIN_CONFIDENCE=0.65


# Allow LIVE trading execution (one of three flags required together)
ALLOW_LIVE=false
