# Conservative live-deployment template (tiny risk caps).
#
# This documents the risk caps an operator would use when going live. The
# live-authority flags themselves are fail-closed here by design -- see the
# block below. Loading this file gives you the conservative caps and Testnet,
# never real-money execution.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Exchange (Bybit testnet/live toggles)
EXCHANGE_ID=bybit
BYBIT_TESTNET=true
EXECUTION_MODE=testnet

# -------------------------------------------------------------------------
# Real-money live mode requires a separate operator-controlled configuration.
# Never enable it from a tracked repository template.
#
# The three flags below must ALL be set for live authority. They are shipped
# fail-closed and must stay that way: a tracked file is loaded by tooling,
# CI and anyone who clones this repo, so an enabled value here is an accident
# waiting for the right command. An operator enables live deliberately, in a
# file that is not in version control:
#
#     ENABLE_LIVE=true
#     ALLOW_LIVE=true
#     LIVE_CONFIRM=YES
#
# A CI check (tests/test_no_committed_secrets.py) fails if any tracked
# configuration file carries those values.
# -------------------------------------------------------------------------
ENABLE_LIVE=false
ALLOW_LIVE=false
LIVE_CONFIRM=NO

# Risk controls (very small)
DAILY_LOSS_LIMIT=0.02
LIVE_ORDER_USD=2
MAX_ORDER_SIZE=0.01
CIRCUIT_BREAKER_PCT=0.05
SIGNALS_DEDUPE_WINDOW_SEC=600

# Training & schedules
TRAIN_DAILY_UTC=02:00
TRAIN_DAYS=60
TRAIN_TIMEFRAMES=5m,15m,1h,4h,1d

# Metrics
METRICS_PORT=9100

# Proxy (optional)
# PROXY_URL=http://USER:PASS@YOUR_EU_PROXY:PORT