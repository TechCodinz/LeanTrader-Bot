# =====================================================
# TRADING BOT CONFIGURATION
# Copy to .env and fill in your values
# =====================================================

# =====================================================
# CEX TRADING (Required for centralized exchanges)
# =====================================================

# Bybit (Primary CEX)
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET=your_bybit_secret_here

# Gate.io (Backup CEX)
GATE_API_KEY=your_gate_api_key_here
GATE_SECRET=your_gate_secret_here

# Binance (Optional)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here

# =====================================================
# DEX TRADING (Required for decentralized exchanges)
# =====================================================

# Wallet Configuration
PRIVATE_KEY=0xyour_private_key_here
WALLET_ADDRESS=0xyour_wallet_address_here

# RPC URLs (Optional - defaults to public RPCs)
ETH_RPC_URL=https://eth.llamarpc.com
BSC_RPC_URL=https://bsc-dataseed1.binance.org
POLYGON_RPC_URL=https://polygon-rpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Flashbots (Optional - for MEV protection)
FLASHBOTS_API_KEY=your_flashbots_key_here

# =====================================================
# TELEGRAM (Optional - for notifications)
# =====================================================

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here
TELEGRAM_VIP_CHANNEL=@your_vip_channel
TELEGRAM_FREE_CHANNEL=@your_free_channel

# =====================================================
# IBM QUANTUM (Optional - for quantum features)
# =====================================================

QISKIT_IBM_TOKEN=your_ibm_quantum_token_here

# =====================================================
# MOON SPOTTING APIS (Optional - for better data)
# =====================================================

# Social Media
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_secret_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_secret_here
REDDIT_USER_AGENT=TradingBot/1.0

DISCORD_BOT_TOKEN=your_discord_token_here

# Blockchain Explorers
ETHERSCAN_API_KEY=your_etherscan_key_here
BSCSCAN_API_KEY=your_bscscan_key_here
POLYGONSCAN_API_KEY=your_polygonscan_key_here
ARBISCAN_API_KEY=your_arbiscan_key_here

# Safety Checkers
HONEYPOT_API_KEY=your_honeypot_api_key_here
TOKENSNIFFER_API_KEY=your_tokensniffer_key_here
GOPLUSLABS_API_KEY=your_gopluslabs_key_here

# =====================================================
# RISK MANAGEMENT (Configure limits)
# =====================================================

MAX_POSITION_USD=100
MAX_DAILY_LOSS=500
MAX_POSITIONS=10
MAX_SLIPPAGE_BPS=50

# =====================================================
# MODE (testnet or live)
# =====================================================

TRADING_MODE=testnet
