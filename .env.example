# ===================================
# MINIMUM SETUP (Required for Trading)
# ===================================

# Exchange API (Choose ONE - get from exchange testnet)
BYBIT_API_KEY=your_testnet_key_here
BYBIT_API_SECRET=your_testnet_secret_here
USE_TESTNET=true
ENABLE_LIVE=false

# ===================================
# RECOMMENDED ADDITIONS (Optional)
# ===================================

# AI Enhancement (makes evolution smarter)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# Notifications (get trade alerts)
# Get from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id

# ===================================
# FULL POWER (Optional - All Features)
# ===================================

# Additional AI
# OPENAI_API_KEY=your_openai_key
# HUGGINGFACE_TOKEN=your_hf_token

# Market Data
# COINGECKO_API_KEY=your_key
# ETHERSCAN_API_KEY=your_key

# News & Sentiment
# NEWS_API_KEY=your_key
# TWITTER_API_KEY=your_key
# TWITTER_API_SECRET=your_secret
# TWITTER_BEARER_TOKEN=your_token
# REDDIT_CLIENT_ID=your_id
# REDDIT_CLIENT_SECRET=your_secret

# Additional Exchanges
# BINANCE_API_KEY=your_key
# BINANCE_API_SECRET=your_secret
# GATEIO_API_KEY=your_key
# GATEIO_API_SECRET=your_secret
# OKX_API_KEY=your_key
# OKX_API_SECRET=your_secret
# OKX_PASSPHRASE=your_passphrase

# Forex Brokers
# OANDA_API_KEY=your_key
# MT5_LOGIN=your_login
# MT5_PASSWORD=your_password
# MT5_SERVER=your_server

# Infrastructure
# REDIS_URL=redis://localhost:6379
# STRIPE_API_KEY=your_stripe_key
