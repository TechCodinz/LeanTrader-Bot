# ===========================================
# ULTRA TRADING SYSTEM - LIVE TRADING MODE
# ===========================================

# ===========================================
# TRADING MODE & SAFETY
# ===========================================
ENABLE_LIVE=true
ALLOW_LIVE=true
LIVE_CONFIRM=YES
EXCHANGE_MODE=spot

# ===========================================
# EXCHANGE CONFIGURATION
# ===========================================
EXCHANGE_ID=gateio
PAPER_START_CASH=5000

# Gate.io Configuration (LIVE)
GATEIO_API_KEY=your_gateio_api_key_here
GATEIO_SECRET=your_gateio_secret_here
GATEIO_SANDBOX=false

# Bybit Configuration (BACKUP)
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET=your_bybit_secret_here
BYBIT_TESTNET=false

# Binance Configuration (BACKUP)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here
BINANCE_TESTNET=false

# ===========================================
# RISK MANAGEMENT (CONSERVATIVE FOR LIVE)
# ===========================================
RISK_PER_TRADE=0.01
MAX_POSITIONS=3
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.06
MAX_DRAWDOWN_PCT=0.10
INITIAL_CAPITAL=1000

# ===========================================
# META-BRAIN & ENSEMBLE LEARNING
# ===========================================
META_BRAIN_ENABLED=true
ENSEMBLE_LEARNING=true
PERFORMANCE_TRACKING=true
MODEL_UPDATE_INTERVAL=86400
REBALANCE_INTERVAL=3600

# ===========================================
# COPY SIGNALS & EXTERNAL INTEGRATION
# ===========================================
COPY_SIGNALS_ENABLED=true
SIGNALS_INBOX_DIR=/opt/leantrader/inbox_signals
SIGNALS_PROCESSING_INTERVAL=300
EXTERNAL_SIGNALS_ENABLED=true

# ===========================================
# MULTI-EXCHANGE SWARM TRAINING
# ===========================================
SWARM_ENABLED=true
PARALLEL_TRAINING=true
EXCHANGE_ISOLATION=true
SWARM_AGENTS=100
TRAINING_INTERVAL=3600

# ===========================================
# ULTRA GOD MODE FEATURES
# ===========================================
GOD_MODE_ENABLED=true
QUANTUM_PREDICTION=true
FRACTAL_ANALYSIS=true
SMART_MONEY_TRACKING=true
MOON_SPOTTER_ENABLED=true
AUTO_SNIPE_ENABLED=false
MAX_SNIPE_AMOUNT=50

# ===========================================
# FOREX & METALS MASTER
# ===========================================
FOREX_MASTER_ENABLED=true
TRADE_FOREX=true
TRADE_METALS=true
TRADE_COMMODITIES=true
FOREX_SYMBOLS=EURUSD,GBPUSD,USDJPY
METALS_SYMBOLS=XAUUSD,XAGUSD
COMMODITIES_SYMBOLS=USOIL,NGAS

# ===========================================
# TELEGRAM NOTIFICATIONS (ENABLED FOR LIVE)
# ===========================================
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_VIP_CHANNEL=your_vip_channel_id_here
TELEGRAM_HEARTBEAT=true
TELEGRAM_SIGNALS=true
HEARTBEAT_SECS=1800

# ===========================================
# NEWS & SENTIMENT ANALYSIS
# ===========================================
NEWS_EVERY_SECS=600
SENTIMENT_ANALYSIS=true
NEWS_SOURCES=investing,cryptopanic,reddit,twitter

# ===========================================
# SIGNALS & SCANNING
# ===========================================
SIGNALS_LOOP=true
SIGNALS_EVERY_SECS=180
DAILY_RUN=true
SCAN_INTERVAL=30

# ===========================================
# MONITORING & METRICS
# ===========================================
METRICS_ENABLED=true
METRICS_PORT=9300
PROMETHEUS_ENABLED=true
DASHBOARD_ENABLED=true

# ===========================================
# LOGGING & DEBUGGING
# ===========================================
LOG_LEVEL=INFO
DEBUG_MODE=false
VERBOSE_LOGGING=false
LOG_RETENTION_DAYS=30

# ===========================================
# DATABASE & STORAGE
# ===========================================
DATABASE_URL=sqlite:///leantrader_live.db
REDIS_URL=redis://localhost:6379/0
LEDGER_PATH=/opt/leantrader/data/live_ledger.csv
REPORTS_DIR=/opt/leantrader/out/live/reports
MODEL_DIR=/opt/leantrader/out/live/models
CHECKPOINT_DIR=/opt/leantrader/out/live/checkpoints

# ===========================================
# ADVANCED FEATURES
# ===========================================
ONLINE_LEARNING=true
EVOLUTION_ENABLED=true
MULTI_EXCHANGE=false
USE_NEWS_SENTIMENT=true
USE_ONCHAIN_DATA=true
AWARENESS_ENABLED=true

# ===========================================
# SECURITY & API LIMITS (STRICT FOR LIVE)
# ===========================================
API_RATE_LIMIT=20
BURST_LIMIT=3
COOLDOWN_SECS=3
MAX_RETRIES=5
TIMEOUT_SECS=60

# ===========================================
# NOTIFICATION CHANNELS
# ===========================================
DISCORD_WEBHOOK=
SLACK_WEBHOOK=
EMAIL_NOTIFICATIONS=true
SMS_NOTIFICATIONS=false
