# ===========================================
# ULTRA TRADING SYSTEM - PAPER TRADING MODE
# ===========================================

# ===========================================
# TRADING MODE & SAFETY
# ===========================================
ENABLE_LIVE=false
ALLOW_LIVE=false
LIVE_CONFIRM=NO
EXCHANGE_MODE=spot

# ===========================================
# EXCHANGE CONFIGURATION
# ===========================================
EXCHANGE_ID=paper
PAPER_START_CASH=5000

# ===========================================
# RISK MANAGEMENT
# ===========================================
RISK_PER_TRADE=0.02
MAX_POSITIONS=5
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.10
MAX_DRAWDOWN_PCT=0.20
INITIAL_CAPITAL=5000

# ===========================================
# META-BRAIN & ENSEMBLE LEARNING
# ===========================================
META_BRAIN_ENABLED=true
ENSEMBLE_LEARNING=true
PERFORMANCE_TRACKING=true
MODEL_UPDATE_INTERVAL=3600
REBALANCE_INTERVAL=1800

# ===========================================
# COPY SIGNALS & EXTERNAL INTEGRATION
# ===========================================
COPY_SIGNALS_ENABLED=true
SIGNALS_INBOX_DIR=/opt/leantrader/inbox_signals
SIGNALS_PROCESSING_INTERVAL=300
EXTERNAL_SIGNALS_ENABLED=true

# ===========================================
# MULTI-EXCHANGE SWARM TRAINING
# ===========================================
SWARM_ENABLED=true
PARALLEL_TRAINING=true
EXCHANGE_ISOLATION=true
SWARM_AGENTS=50
TRAINING_INTERVAL=1800

# ===========================================
# ULTRA GOD MODE FEATURES
# ===========================================
GOD_MODE_ENABLED=true
QUANTUM_PREDICTION=true
FRACTAL_ANALYSIS=true
SMART_MONEY_TRACKING=true
MOON_SPOTTER_ENABLED=true
AUTO_SNIPE_ENABLED=false
MAX_SNIPE_AMOUNT=50

# ===========================================
# FOREX & METALS MASTER
# ===========================================
FOREX_MASTER_ENABLED=true
TRADE_FOREX=true
TRADE_METALS=true
TRADE_COMMODITIES=true
FOREX_SYMBOLS=EURUSD,GBPUSD,USDJPY
METALS_SYMBOLS=XAUUSD,XAGUSD
COMMODITIES_SYMBOLS=USOIL,NGAS

# ===========================================
# TELEGRAM NOTIFICATIONS
# ===========================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_VIP_CHANNEL=
TELEGRAM_HEARTBEAT=false
TELEGRAM_SIGNALS=false
HEARTBEAT_SECS=3600

# ===========================================
# NEWS & SENTIMENT ANALYSIS
# ===========================================
NEWS_EVERY_SECS=900
SENTIMENT_ANALYSIS=true
NEWS_SOURCES=investing,cryptopanic,reddit,twitter

# ===========================================
# SIGNALS & SCANNING
# ===========================================
SIGNALS_LOOP=true
SIGNALS_EVERY_SECS=300
DAILY_RUN=true
SCAN_INTERVAL=60

# ===========================================
# MONITORING & METRICS
# ===========================================
METRICS_ENABLED=true
METRICS_PORT=9300
PROMETHEUS_ENABLED=true
DASHBOARD_ENABLED=true

# ===========================================
# LOGGING & DEBUGGING
# ===========================================
LOG_LEVEL=INFO
DEBUG_MODE=true
VERBOSE_LOGGING=true
LOG_RETENTION_DAYS=7

# ===========================================
# DATABASE & STORAGE
# ===========================================
DATABASE_URL=sqlite:///leantrader_paper.db
REDIS_URL=redis://localhost:6379/1
LEDGER_PATH=/opt/leantrader/data/paper_ledger.csv
REPORTS_DIR=/opt/leantrader/out/paper/reports
MODEL_DIR=/opt/leantrader/out/paper/models
CHECKPOINT_DIR=/opt/leantrader/out/paper/checkpoints

# ===========================================
# ADVANCED FEATURES
# ===========================================
ONLINE_LEARNING=true
EVOLUTION_ENABLED=true
MULTI_EXCHANGE=false
USE_NEWS_SENTIMENT=true
USE_ONCHAIN_DATA=true
AWARENESS_ENABLED=false

# ===========================================
# SECURITY & API LIMITS
# ===========================================
API_RATE_LIMIT=50
BURST_LIMIT=5
COOLDOWN_SECS=1
MAX_RETRIES=3
TIMEOUT_SECS=30
