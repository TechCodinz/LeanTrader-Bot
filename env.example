# ===========================================
# ULTRA TRADING SYSTEM - ENVIRONMENT CONFIG
# ===========================================

# ===========================================
# TRADING MODE & SAFETY
# ===========================================
# Trading Mode: paper, live
ENABLE_LIVE=false
ALLOW_LIVE=false
LIVE_CONFIRM=NO
EXCHANGE_MODE=spot

# ===========================================
# EXCHANGE CONFIGURATION
# ===========================================
# Primary Exchange
EXCHANGE_ID=paper
PAPER_START_CASH=5000

# Gate.io Configuration
GATEIO_API_KEY=your_gateio_api_key_here
GATEIO_SECRET=your_gateio_secret_here
GATEIO_SANDBOX=false

# Bybit Configuration
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET=your_bybit_secret_here
BYBIT_TESTNET=true

# Binance Configuration
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here
BINANCE_TESTNET=true

# OKX Configuration
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET=your_okx_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here
OKX_SANDBOX=true

# KuCoin Configuration
KUCOIN_API_KEY=your_kucoin_api_key_here
KUCOIN_SECRET=your_kucoin_secret_here
KUCOIN_PASSPHRASE=your_kucoin_passphrase_here
KUCOIN_SANDBOX=true

# MEXC Configuration
MEXC_API_KEY=your_mexc_api_key_here
MEXC_SECRET=your_mexc_secret_here

# Bitget Configuration
BITGET_API_KEY=your_bitget_api_key_here
BITGET_SECRET=your_bitget_secret_here
BITGET_PASSPHRASE=your_bitget_passphrase_here

# ===========================================
# RISK MANAGEMENT
# ===========================================
RISK_PER_TRADE=0.02
MAX_POSITIONS=5
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.10
MAX_DRAWDOWN_PCT=0.20
INITIAL_CAPITAL=10000

# ===========================================
# META-BRAIN & ENSEMBLE LEARNING
# ===========================================
META_BRAIN_ENABLED=true
ENSEMBLE_LEARNING=true
PERFORMANCE_TRACKING=true
MODEL_UPDATE_INTERVAL=86400
REBALANCE_INTERVAL=3600

# ===========================================
# COPY SIGNALS & EXTERNAL INTEGRATION
# ===========================================
COPY_SIGNALS_ENABLED=true
SIGNALS_INBOX_DIR=/opt/leantrader/inbox_signals
SIGNALS_PROCESSING_INTERVAL=300
EXTERNAL_SIGNALS_ENABLED=true

# ===========================================
# MULTI-EXCHANGE SWARM TRAINING
# ===========================================
SWARM_ENABLED=true
PARALLEL_TRAINING=true
EXCHANGE_ISOLATION=true
SWARM_AGENTS=100
TRAINING_INTERVAL=3600

# ===========================================
# ULTRA GOD MODE FEATURES
# ===========================================
GOD_MODE_ENABLED=true
QUANTUM_PREDICTION=true
FRACTAL_ANALYSIS=true
SMART_MONEY_TRACKING=true
MOON_SPOTTER_ENABLED=true
AUTO_SNIPE_ENABLED=true
MAX_SNIPE_AMOUNT=100

# ===========================================
# FOREX & METALS MASTER
# ===========================================
FOREX_MASTER_ENABLED=true
TRADE_FOREX=true
TRADE_METALS=true
TRADE_COMMODITIES=true
FOREX_SYMBOLS=EURUSD,GBPUSD,USDJPY
METALS_SYMBOLS=XAUUSD,XAGUSD
COMMODITIES_SYMBOLS=USOIL,NGAS

# ===========================================
# TELEGRAM NOTIFICATIONS
# ===========================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_VIP_CHANNEL=your_vip_channel_id_here
TELEGRAM_HEARTBEAT=false
TELEGRAM_SIGNALS=false
HEARTBEAT_SECS=3600

# ===========================================
# NEWS & SENTIMENT ANALYSIS
# ===========================================
NEWS_EVERY_SECS=900
SENTIMENT_ANALYSIS=true
NEWS_SOURCES=investing,cryptopanic,reddit,twitter

# ===========================================
# SIGNALS & SCANNING
# ===========================================
SIGNALS_LOOP=false
SIGNALS_EVERY_SECS=300
DAILY_RUN=true
SCAN_INTERVAL=60

# ===========================================
# MONITORING & METRICS
# ===========================================
METRICS_ENABLED=true
METRICS_PORT=9300
PROMETHEUS_ENABLED=true
DASHBOARD_ENABLED=true

# ===========================================
# LOGGING & DEBUGGING
# ===========================================
LOG_LEVEL=INFO
DEBUG_MODE=false
VERBOSE_LOGGING=false
LOG_RETENTION_DAYS=30

# ===========================================
# DATABASE & STORAGE
# ===========================================
DATABASE_URL=sqlite:///leantrader.db
REDIS_URL=redis://localhost:6379/0
LEDGER_PATH=/opt/leantrader/data/ledger.csv
REPORTS_DIR=/opt/leantrader/out/reports
MODEL_DIR=/opt/leantrader/out/models
CHECKPOINT_DIR=/opt/leantrader/out/checkpoints

# ===========================================
# ADVANCED FEATURES
# ===========================================
ONLINE_LEARNING=true
EVOLUTION_ENABLED=true
MULTI_EXCHANGE=false
USE_NEWS_SENTIMENT=true
USE_ONCHAIN_DATA=true
AWARENESS_ENABLED=false

# ===========================================
# SECURITY & API LIMITS
# ===========================================
API_RATE_LIMIT=100
BURST_LIMIT=10
COOLDOWN_SECS=2
MAX_RETRIES=3
TIMEOUT_SECS=30

# ===========================================
# NOTIFICATION CHANNELS
# ===========================================
DISCORD_WEBHOOK=
SLACK_WEBHOOK=
EMAIL_NOTIFICATIONS=false
SMS_NOTIFICATIONS=false

# ===========================================
# BACKTESTING & RESEARCH
# ===========================================
BACKTEST_ENABLED=false
BACKTEST_START_DATE=2023-01-01
BACKTEST_END_DATE=2024-01-01
RESEARCH_MODE=false
OPTIMIZATION_ENABLED=false