# Professional Trading Bot Configuration
# Copy this file to .env and fill in your actual values

# Bot Configuration
BOT_NAME=ProfessionalTradingBot
VERSION=1.0.0
TRADING_ENABLED=false
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=sqlite:///data/trading_bot.db
REDIS_URL=redis://localhost:6379

# Exchange APIs (REQUIRED - Add your actual API keys)
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET_KEY=your_bybit_secret_key_here
BYBIT_SANDBOX=true
BYBIT_TESTNET=true

COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_SECRET_KEY=your_coinbase_secret_key_here
COINBASE_PASSPHRASE=your_coinbase_passphrase_here
COINBASE_SANDBOX=true

# Trading Configuration
INITIAL_CAPITAL=10000
MAX_POSITION_SIZE=0.1
MAX_POSITIONS=10
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.1
MIN_CONFIDENCE=0.7
POSITION_SIZE_PCT=0.1

# Risk Management
MAX_TOTAL_EXPOSURE=0.8
MAX_DRAWDOWN=0.15
MAX_VAR=0.05
MAX_CORRELATION=0.7
MAX_CONCENTRATION=0.3
MAX_LEVERAGE=1.0

# ML Configuration
MODEL_RETRAIN_HOURS=24
LOOKBACK_PERIOD=1000
FEATURE_WINDOW=50
PREDICTION_HORIZON=5

# Notification Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password_here
EMAIL_RECIPIENT=recipient@gmail.com

TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER=+1234567890

WEBHOOK_URL=your_webhook_url_here

# Dashboard Configuration
DASHBOARD_PORT=8501
DASHBOARD_HOST=0.0.0.0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/trading/trading_bot.log

# Security Configuration
API_RATE_LIMIT=100
MAX_CONCURRENT_REQUESTS=10
ENABLE_SSL=true
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=8000
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true

# Backup Configuration
ENABLE_BACKUP=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/backup/trading_bot


