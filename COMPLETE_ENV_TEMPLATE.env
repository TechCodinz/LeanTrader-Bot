# ============================================
# BYBIT - Spot, Futures, Perpetuals, Forex
# ============================================
# TESTNET (for training)
BYBIT_TESTNET_API_KEY=your_bybit_testnet_key
BYBIT_TESTNET_API_SECRET=your_bybit_testnet_secret

# MAINNET (for live trading)
BYBIT_API_KEY=your_bybit_mainnet_key
BYBIT_API_SECRET=your_bybit_mainnet_secret

# ============================================
# BINANCE - Largest exchange (1,600+ pairs)
# ============================================
BINANCE_API_KEY=your_binance_key
BINANCE_API_SECRET=your_binance_secret

# ============================================
# OKX - Derivatives & Spot (2,161+ pairs)
# ============================================
OKX_API_KEY=your_okx_key
OKX_API_SECRET=your_okx_secret
OKX_PASSWORD=your_okx_passphrase

# ============================================
# KUCOIN - Altcoins (1,155+ pairs)
# ============================================
KUCOIN_API_KEY=your_kucoin_key
KUCOIN_API_SECRET=your_kucoin_secret
KUCOIN_PASSWORD=your_kucoin_passphrase

# ============================================
# GATE.IO - Low fees (good for arbitrage)
# ============================================
GATE_API_KEY=your_gate_key
GATE_API_SECRET=your_gate_secret

# ============================================
# TRADING MODE
# ============================================
TRADING_MODE=testnet         # testnet, paper, or live
ENABLE_LIVE=false           # Set true for live trading
USE_TESTNET_FOR_TRAINING=true  # Train on testnet, trade live elsewhere

# ============================================
# RISK MANAGEMENT (SAFE DEFAULTS)
# ============================================
MAX_POSITION_SIZE=50        # Max $ per position
MAX_DAILY_TRADES=20        # Max trades per day
MAX_DAILY_LOSS=100         # Emergency stop at $100 loss
MIN_CONFIDENCE=0.80        # Minimum 80% confidence
USE_STOP_LOSS=true
STOP_LOSS_PERCENT=2        # 2% stop loss
USE_TRAILING_STOP=true
TRAILING_STOP_PERCENT=1    # 1% trailing stop

# ============================================
# ARBITRAGE SETTINGS
# ============================================
MIN_ARBITRAGE_PROFIT=0.5   # Minimum 0.5% profit
MAX_ARBITRAGE_POSITIONS=10 # Max simultaneous arbitrage trades

# ============================================
# DYNAMIC PAIR DISCOVERY
# ============================================
MIN_VOLUME_USD=50000       # Minimum $50k daily volume
MIN_VOLATILITY=0.005       # Minimum 0.5% volatility
SCAN_INTERVAL=3600         # Scan every hour
MAX_PAIRS=5000            # Max pairs to track

# ============================================
# ADVANCED FEATURES
# ============================================
USE_LEVERAGE=false         # Enable leverage trading (RISKY!)
MAX_LEVERAGE=3            # Max 3X leverage if enabled
USE_GRID_TRADING=true     # Enable grid trading
USE_DCA=true              # Enable dollar cost averaging
