# Supported VPS release: paper trading only.
TRADING_MODE=paper
ENABLE_LIVE=false
ALLOW_LIVE=false
LIVE_CONFIRM=NO

# Public market data. No API credentials are required.
DATA_EXCHANGE=bybit
# AUTO discovers every eligible active Bybit spot market, intersects it with
# Bybit Testnet when enabled, then rotates through the full set fairly.
PAPER_SYMBOLS=AUTO
MARKET_QUOTE=USDT
MARKET_UNIVERSE_STATE_PATH=runtime/vps_market_universe.json
EXCHANGE_INTELLIGENCE_STATE_PATH=runtime/vps_exchange_intelligence.json
MARKET_SCAN_BATCH_SIZE=18
MARKET_REFRESH_SECONDS=3600
MARKET_MIN_QUOTE_VOLUME_USD=250000
MARKET_MAX_SPREAD_BPS=75
PAPER_TIMEFRAME=15m
# AUTO loads every parseable candle interval advertised by the configured
# exchange. Bybit startup additionally requires its complete verified matrix.
CONFIRM_TIMEFRAMES=AUTO
PAPER_CANDLE_LIMIT=320
POLL_INTERVAL=60

# Conservative defaults for the planned $50 starting account.
PAPER_START_CASH=50
PAPER_ORDER_USD=2
MAX_OPEN_POSITIONS=2
MAX_POSITION_PCT=0.10
RISK_PER_TRADE_PCT=0.005
MAX_ENTRIES_PER_SYMBOL=2
SCALE_IN_MIN_CONFIDENCE=0.75
MAX_DAILY_LOSS_PCT=0.02
MAX_DRAWDOWN_PCT=0.10
PAPER_FEE_BPS=10
PAPER_SLIPPAGE_BPS=5
ATR_STOP_MULT=1.5
ATR_TRAIL_MULT=2.0
PARTIAL_TAKE_PROFIT_ATR=1.5
PARTIAL_TAKE_PROFIT_FRACTION=0.50
FINAL_TAKE_PROFIT_ATR=3.0

PAPER_STATE_PATH=runtime/vps_paper_state.json
INTELLIGENCE_STATE_PATH=runtime/vps_intelligence_state.json
PATTERN_MEMORY_PATH=runtime/vps_pattern_memory.json
NEWS_STATE_PATH=runtime/vps_news_state.json
PUBLIC_CONTEXT_STATE_PATH=runtime/vps_public_context.json
PUBLIC_CONTEXT_ENABLED=true
PUBLIC_CONTEXT_REFRESH_SECONDS=900
NEWS_MAX_AGE_SECONDS=86400
NEWS_MAX_FUTURE_SKEW_SECONDS=300
# Exchange/server time is re-attested and only fully closed, fresh candles are
# eligible for paper/Testnet decisions. Internal timestamps remain UTC.
MAX_CLOCK_OFFSET_MS=5000
CLOCK_SYNC_SECONDS=300
CANDLE_STALE_MULTIPLIER=2.5
# Read-only cross-venue arbitrage research. Quotes are cost-adjusted and
# observable, but this release never grants arbitrage execution authority.
ARBITRAGE_MONITOR_ENABLED=true
ARBITRAGE_VENUES=bybit,okx
ARBITRAGE_REFRESH_SECONDS=60
ARBITRAGE_SLIPPAGE_BPS=3
STRATEGY_OBSERVATORY_STATE_PATH=runtime/vps_strategy_observatory.json
RESEARCH_STATE_PATH=runtime/vps_research_governor.json
# Optional structured AI research. The model may propose bounded paper
# challengers; causal replay and evidence gates decide eligibility. It never
# receives execution authority. Keep disabled until a provider key file exists.
MODEL_RESEARCH_STATE_PATH=runtime/vps_model_research.json
MODEL_RESEARCH_ENABLED=false
MODEL_RESEARCH_PROVIDER=
MODEL_RESEARCH_MODEL=
MODEL_RESEARCH_API_KEY_FILE=/run/secrets/model_research_api_key
MODEL_RESEARCH_ENDPOINT=
MODEL_RESEARCH_INTERVAL_CYCLES=60
DECISION_ROUTER_STATE_PATH=runtime/vps_decision_router.json
# CNS / Brain / long-term causal memory / capital growth state. These are
# independent persistent files so any corruption/failure is visible and bounded.
CNS_STATE_PATH=runtime/vps_cns_state.json
BRAIN_STATE_PATH=runtime/vps_brain_state.json
MEMORY_RETENTION_STATE_PATH=runtime/vps_memory_retention.json
LEGACY_MEMORY_PATH=runtime/memory.jsonl
ERROR_ATTRIBUTION_STATE_PATH=runtime/vps_error_attribution.json
CAPITAL_GROWTH_STATE_PATH=runtime/vps_capital_growth.json
MARKET_WORLD_MODEL_STATE_PATH=runtime/vps_market_world_model.json
META_COGNITION_STATE_PATH=runtime/vps_meta_cognition.json
INTELLIGENCE_COUNCIL_STATE_PATH=runtime/vps_intelligence_council.json
ADVERSARIAL_CRITIC_STATE_PATH=runtime/vps_adversarial_critic.json
HYPOTHESIS_LAB_STATE_PATH=runtime/vps_hypothesis_lab.json
ACTIVE_RESEARCH_STATE_PATH=runtime/vps_active_research.json
TAIL_RISK_STATE_PATH=runtime/vps_tail_risk.json
MEMORY_MAX_EPISODES=5000
MEMORY_HALF_LIFE_HOURS=720
BRAIN_MIN_STRATEGY_SAMPLES=50
BRAIN_NEGATIVE_EXPECTANCY_FLOOR=-0.001
BRAIN_QUARANTINE_MIN_SAMPLES=100
BRAIN_QUARANTINE_EXPECTANCY_FLOOR=-0.004
BRAIN_RECOVERY_EXPECTANCY_FLOOR=0.0005
CAPITAL_PRINCIPAL_FLOOR_FRACTION=0.70
CAPITAL_PROFIT_REINVEST_FRACTION=0.50
PROVENANCE_PATH=runtime/vps_decision_provenance.jsonl
PROMETHEUS_METRICS_PATH=runtime/vps_metrics.prom

# Optional outbound paper alerts only. Never grants execution authority.
# Store the token in secrets/telegram_bot_token; never put it in this file.
TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
# Admin receives fills, halts, scanner/arbitrage alerts and health digests.
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_FREE_CHAT_ID=
TELEGRAM_PAID_CHAT_ID=
TELEGRAM_FREE_MIN_CONFIDENCE=0.85
TELEGRAM_PAID_MIN_CONFIDENCE=0.70
TELEGRAM_MOON_MIN_SCORE=1.0
TELEGRAM_SIGNAL_COOLDOWN_SECONDS=900
TELEGRAM_MONITOR_INTERVAL_CYCLES=60
TELEGRAM_TESTNET_TRADE_URL=https://testnet.bybit.com/
HEARTBEAT_PATH=runtime/vps_heartbeat.json
HEARTBEAT_MAX_AGE=180
TRADES_LOG_PATH=logs/vps_trades.jsonl
LOG_LEVEL=INFO

# Bounded adaptation: evidence is accumulated from closed paper trades, then
# strategy weights move slowly and remain between 10% and 70%.
ADAPTIVE_LEARNING_RATE=0.08
ADAPTIVE_MIN_SAMPLES=5

# Adaptive + ultra-engine routing and market-specific net performance evidence.
MARKET_EVIDENCE_MIN_SAMPLES=8
MARKET_EVIDENCE_WINDOW=50
ROUTER_MIN_ADVANCED_CONFIDENCE=0.20
ROUTER_MIN_COMBINED_SCORE=0.20
ROUTER_NEGATIVE_CONSENSUS_VETO=-0.25

# A repeatedly failing engine is isolated briefly instead of crashing the loop.
ENGINE_FAILURE_THRESHOLD=3
ENGINE_RECOVERY_SECONDS=60

# Optional authenticated Bybit sandbox mirror. These credentials must belong
# to testnet.bybit.com and are read only from root-owned files mounted at
# /run/secrets. Production keys and production endpoints are never accepted.
BYBIT_TESTNET_ENABLED=false
BYBIT_TESTNET_CONFIRM=
BYBIT_TESTNET_API_KEY_FILE=/run/secrets/bybit_testnet_api_key
BYBIT_TESTNET_API_SECRET_FILE=/run/secrets/bybit_testnet_api_secret
BYBIT_TESTNET_STATE_PATH=runtime/vps_testnet_execution.json
BYBIT_TESTNET_MAX_ORDER_USD=10
BYBIT_TESTNET_MAX_POSITION_USD=20
BYBIT_TESTNET_MAX_DAILY_SUBMITTED_USD=50
BYBIT_TESTNET_MAX_ORDERS_PER_DAY=20
