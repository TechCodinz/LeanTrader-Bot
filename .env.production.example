# Supported VPS release: paper trading only.
TRADING_MODE=paper
ENABLE_LIVE=false
ALLOW_LIVE=false
LIVE_CONFIRM=NO

# Public market data. No API credentials are required.
DATA_EXCHANGE=bybit
PAPER_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
PAPER_TIMEFRAME=15m
PAPER_CANDLE_LIMIT=320
POLL_INTERVAL=60

# Conservative defaults for the planned $50 starting account.
PAPER_START_CASH=50
PAPER_ORDER_USD=2
MAX_OPEN_POSITIONS=2
MAX_POSITION_PCT=0.10
MAX_DAILY_LOSS_PCT=0.02
MAX_DRAWDOWN_PCT=0.10
PAPER_FEE_BPS=10
PAPER_SLIPPAGE_BPS=5
ATR_STOP_MULT=1.5
ATR_TRAIL_MULT=2.0

PAPER_STATE_PATH=runtime/vps_paper_state.json
HEARTBEAT_PATH=runtime/vps_heartbeat.json
HEARTBEAT_MAX_AGE=180
TRADES_LOG_PATH=logs/vps_trades.jsonl
LOG_LEVEL=INFO
