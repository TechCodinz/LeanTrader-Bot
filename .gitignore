# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/

# Large log files (keep local only)
*.log
logs/*.log

# Sensitive data (NEVER COMMIT)
.env
.env.backup
*.key
*.pem
*_secret*
*_token*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
*.cache
*.pyc

# IMPORTANT: Include these (learned data)
!*.db
!models/
!data/
!users_db.json
!learned_data_backup/

# Git files
*.orig
*.rej

# Runtime state written by the running bot. Never source, never committed.
# vault_keys.json and vault_kv.json in particular hold generated key
# material; the sibling Lean-Trader repository already excludes these for
# the same reason.
runtime/vault_keys.json
runtime/vault_kv.json
runtime/paper_state.json
runtime/signals-*.ndjson
runtime/execution_telemetry.json
runtime/rpb_positions.json
