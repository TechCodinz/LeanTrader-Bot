# Security - Never commit these!
.env
*.key
*.pem
private_keys/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Databases
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temporary
tmp/
temp/
*.tmp

# Cached market data written at runtime; never source, and a zero-filled
# cache is how fabricated candles used to reach strategies.
runtime/market_cache/

# Regenerated by OMNISCIENT_TRADING_MODE.py when run deliberately.
EXECUTION_ORCHESTRATOR.py.pre_omniscient
OMNISCIENT_EXECUTION_ENGINE.py

# Runtime state written by the process and by test runs. vault_keys.json in
# particular holds generated key material and must never be committed.
runtime/paper_state.json
runtime/vault_keys.json
runtime/vault_kv.json
runtime/risk_guard.json
runtime/execution_telemetry.json
runtime/execution_telemetry.json.tmp
.state/
