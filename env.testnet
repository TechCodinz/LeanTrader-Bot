# ===========================================
# ULTRA TRADING SYSTEM - TESTNET MODE
# ===========================================

# ===========================================
# TRADING MODE & SAFETY
# ===========================================
ENABLE_LIVE=false
ALLOW_LIVE=false
LIVE_CONFIRM=NO
EXCHANGE_MODE=spot

# ===========================================
# EXCHANGE CONFIGURATION
# ===========================================
EXCHANGE_ID=bybit
PAPER_START_CASH=10000

# Bybit Testnet Configuration
BYBIT_API_KEY=your_bybit_testnet_api_key_here
BYBIT_SECRET=your_bybit_testnet_secret_here
BYBIT_TESTNET=true

# Binance Testnet Configuration (BACKUP)
BINANCE_API_KEY=your_binance_testnet_api_key_here
BINANCE_SECRET=your_binance_testnet_secret_here
BINANCE_TESTNET=true

# ===========================================
# RISK MANAGEMENT (AGGRESSIVE FOR TESTNET)
# ===========================================
RISK_PER_TRADE=0.05
MAX_POSITIONS=10
STOP_LOSS_PCT=0.08
TAKE_PROFIT_PCT=0.15
MAX_DRAWDOWN_PCT=0.30
INITIAL_CAPITAL=10000

# ===========================================
# META-BRAIN & ENSEMBLE LEARNING
# ===========================================
META_BRAIN_ENABLED=true
ENSEMBLE_LEARNING=true
PERFORMANCE_TRACKING=true
MODEL_UPDATE_INTERVAL=1800
REBALANCE_INTERVAL=900

# ===========================================
# COPY SIGNALS & EXTERNAL INTEGRATION
# ===========================================
COPY_SIGNALS_ENABLED=true
SIGNALS_INBOX_DIR=/opt/leantrader/inbox_signals
SIGNALS_PROCESSING_INTERVAL=180
EXTERNAL_SIGNALS_ENABLED=true

# ===========================================
# MULTI-EXCHANGE SWARM TRAINING
# ===========================================
SWARM_ENABLED=true
PARALLEL_TRAINING=true
EXCHANGE_ISOLATION=true
SWARM_AGENTS=200
TRAINING_INTERVAL=900

# ===========================================
# ULTRA GOD MODE FEATURES
# ===========================================
GOD_MODE_ENABLED=true
QUANTUM_PREDICTION=true
FRACTAL_ANALYSIS=true
SMART_MONEY_TRACKING=true
MOON_SPOTTER_ENABLED=true
AUTO_SNIPE_ENABLED=true
MAX_SNIPE_AMOUNT=200

# ===========================================
# FOREX & METALS MASTER
# ===========================================
FOREX_MASTER_ENABLED=true
TRADE_FOREX=true
TRADE_METALS=true
TRADE_COMMODITIES=true
FOREX_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,CADUSD
METALS_SYMBOLS=XAUUSD,XAGUSD,XPTUSD,XPDUSD
COMMODITIES_SYMBOLS=USOIL,NGAS,WHEAT,CORN

# ===========================================
# TELEGRAM NOTIFICATIONS
# ===========================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_VIP_CHANNEL=
TELEGRAM_HEARTBEAT=false
TELEGRAM_SIGNALS=false
HEARTBEAT_SECS=1800

# ===========================================
# NEWS & SENTIMENT ANALYSIS
# ===========================================
NEWS_EVERY_SECS=300
SENTIMENT_ANALYSIS=true
NEWS_SOURCES=investing,cryptopanic,reddit,twitter,coindesk

# ===========================================
# SIGNALS & SCANNING
# ===========================================
SIGNALS_LOOP=true
SIGNALS_EVERY_SECS=120
DAILY_RUN=true
SCAN_INTERVAL=30

# ===========================================
# MONITORING & METRICS
# ===========================================
METRICS_ENABLED=true
METRICS_PORT=9300
PROMETHEUS_ENABLED=true
DASHBOARD_ENABLED=true

# ===========================================
# LOGGING & DEBUGGING
# ===========================================
LOG_LEVEL=DEBUG
DEBUG_MODE=true
VERBOSE_LOGGING=true
LOG_RETENTION_DAYS=14

# ===========================================
# DATABASE & STORAGE
# ===========================================
DATABASE_URL=sqlite:///leantrader_testnet.db
REDIS_URL=redis://localhost:6379/2
LEDGER_PATH=/opt/leantrader/data/testnet_ledger.csv
REPORTS_DIR=/opt/leantrader/out/testnet/reports
MODEL_DIR=/opt/leantrader/out/testnet/models
CHECKPOINT_DIR=/opt/leantrader/out/testnet/checkpoints

# ===========================================
# ADVANCED FEATURES
# ===========================================
ONLINE_LEARNING=true
EVOLUTION_ENABLED=true
MULTI_EXCHANGE=true
USE_NEWS_SENTIMENT=true
USE_ONCHAIN_DATA=true
AWARENESS_ENABLED=true

# ===========================================
# SECURITY & API LIMITS (RELAXED FOR TESTNET)
# ===========================================
API_RATE_LIMIT=100
BURST_LIMIT=20
COOLDOWN_SECS=1
MAX_RETRIES=5
TIMEOUT_SECS=30
